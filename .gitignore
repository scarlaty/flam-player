# Build output
build/

# External libraries are tracked as git submodules (see .gitmodules)
# lv_conf.h (custom LVGL config) lives beside libs/lvgl and is tracked

# Downloaded fonts (TTF sources, root level only)
/fonts/

# Screenshots & debug logs
*.bmp
*.png
screenshot*
*.log

# Ad-hoc test scripts at root (not tests/ directory)
/test*.lua
saves/

# Python bytecode (convertisseur telmi2flam)
__pycache__/
*.pyc

# Jeux : sortie de build ; les PNG sources des jeux sont versionnes
games/*/_out/
!games/*/img/*.png

# Editor / OS
.vscode/
*.swp
*~
Thumbs.db
.DS_Store

# Packs Telmi (données de test volumineuses, non redistribuables)
/tools/telmi2flam/*.zip
/tools/telmi2flam/*.pk
/tools/telmi2flam/*.plain/

# Caches locaux (archives Telmi, histoires converties, rapports de compatibilite)
.cache/
