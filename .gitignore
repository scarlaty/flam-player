# Build output
build/

# External libraries are tracked as git submodules (see .gitmodules)
# lv_conf.h (custom LVGL config) lives beside libs/lvgl and is tracked

# Downloaded fonts (TTF sources, root level only)
/fonts/

# Screenshots & debug logs
*.bmp
*.png
screenshot*
*.log

# Ad-hoc test scripts at root (not tests/ directory)
/test*.lua
saves/

# Python bytecode (convertisseur telmi2flam)
__pycache__/
*.pyc

# Jeux : sortie de build ; les PNG sources des jeux sont versionnes
games/*/_out/
!games/*/img/*.png
# Vecteurs de parite du decodage PNG (telmi2flam-rs), generes par gen_png_vectors.py
!crates/telmi2flam/tests/vectors/png/*.png
# ... et du redimensionnement (gen_resample_vectors.py)
!crates/telmi2flam/tests/vectors/resample/*.png

# Editor / OS
.vscode/
*.swp
*~
Thumbs.db
.DS_Store

# Packs Telmi (données de test volumineuses, non redistribuables)
/tools/telmi2flam/*.zip
/tools/telmi2flam/*.pk
/tools/telmi2flam/*.plain/

# Caches locaux (archives Telmi, histoires converties, rapports de compatibilite)
.cache/

# Workspace Cargo (launcher + crates/) : sorties de build à la racine (`/target/` plus bas) ;
# l'ancien `target/` du launcher, encore présent dans les copies de travail antérieures au workspace.
apps/flam-launcher/src-tauri/target/
# Surcouche flam-launcher (Tauri) : dépendances et sorties de build ; icônes versionnées
apps/flam-launcher/node_modules/
apps/flam-launcher/dist/
/target/
apps/flam-launcher/src-tauri/gen/
!apps/flam-launcher/src-tauri/icons/*.png
# Captures du design system (docs/DESIGN.md) : le dossier échappe aussi à `screenshot*`
!apps/flam-launcher/docs/screenshots/
!apps/flam-launcher/docs/screenshots/*.png
