# Sources épinglées de ffmpeg embarqué (#209). Lu par build.sh (shell) et par
# apps/flam-launcher/scripts/build-ffmpeg.ps1. Changer une version : mettre à jour l'URL ET le
# SHA-256, relire la configuration dans build.sh, puis la ligne ffmpeg de LICENSES.md.
FFMPEG_VERSION=8.1.3
FFMPEG_TAG=n8.1.3
